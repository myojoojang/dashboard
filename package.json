{
  "name": "dashboard",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.vue src tests vite.config.mts --max-warnings 0",
    "lint:fix": "eslint --ext .ts,.vue src tests vite.config.mts --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "ag-grid-community": "25.3.0",
    "ag-grid-vue": "25.3.0",
    "chart.js": "4.6.1",
    "vue": "2.7.16",
    "vuetify": "2.7.2"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-vue2": "2.3.4",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.33.0",
    "sass": "^1.106.1",
    "tsx": "4.20.6",
    "typescript": "4.9.5",
    "vite": "7.3.7",
    "vue-tsc": "1.8.27"
  },
  "engines": {
    "node": ">=24"
  }
}
